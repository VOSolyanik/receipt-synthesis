    "bookstore": ["professional_book", "entertainment_book"],
    "general_retailer": ["professional_book", "entertainment_book", "hardware"],

    "gym": ["gym_membership", "group_class", "personal_training", "equipment_rent", "sport_apparel", "sports_nutrition", "food_drink"],
